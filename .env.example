# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored: never commit a real connection string or key.
#
# On Vercel these are set in the dashboard (Project -> Settings -> Environment
# Variables), never in a file. A file committed by accident is a leaked secret
# even if you delete it later, because it stays in the repository's history.

# ---------------------------------------------------------------------------
# DATABASE  (required everywhere)
# ---------------------------------------------------------------------------
# The Postgres connection string.
#
# Supabase and Neon both give you more than one string. Use the POOLED one
# (Supabase calls it the "Transaction pooler", Neon puts "-pooler" in the host
# name): serverless functions open and close connections constantly, and the
# pooler is what stops that exhausting the database's connection limit.
#
# For a database running on your own machine, `npm run db:local` prints the
# string to use.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# SESSIONS  (required everywhere)
# ---------------------------------------------------------------------------
# A long random string, used to sign nothing and encrypt nothing: it is kept as
# a guard so that a deployment without it fails loudly instead of running with
# a predictable default. Generate one with:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Changing it is harmless: it does not sign anybody out, because sessions live
# in the database.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# PHOTOGRAPH STORAGE
# ---------------------------------------------------------------------------
# Where photographs the owner uploads are kept.
#
#   local     a folder called .uploads next to the code. Development only: a
#             deployed server's disk is wiped on every deploy, so anything
#             written there disappears. Refused outside development.
#   supabase  Supabase Storage. What Preview and Production use.
#
# Leave this unset and it picks "local" on your machine and "supabase"
# everywhere else, which is almost always what you want.
# PHOTO_STORAGE="local"

# Only needed when PHOTO_STORAGE is supabase.
#
# SUPABASE_URL is the project URL from Supabase -> Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is the service_role key on the same page. It can
# read and write everything in the project, so it must never appear in a file
# that reaches the browser, in this repository, or in a NEXT_PUBLIC_ variable.
# SUPABASE_URL="https://yourproject.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="dog-photos"

# ---------------------------------------------------------------------------
# TESTS  (only for running the end to end suite)
# ---------------------------------------------------------------------------
# The account tests/owner.e2e.mjs signs in as. Create it with
# `npm run owner:create -- --email owner@example.test --name "Test Owner"
# --generate`, which prints a password once. Put the password in your shell,
# not in this file, and never point these at the real owner's account.
# OWNER_TEST_EMAIL="owner@ironboundbullies.test"
# OWNER_TEST_PASSWORD=""
