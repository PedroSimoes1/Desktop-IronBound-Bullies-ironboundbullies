# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored: never commit a real connection string or key.

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# The Postgres connection string. In production this comes from Neon, in the
# owner's own account, and is set in the Vercel dashboard rather than in a file.
#
# Neon gives you two strings. Use the POOLED one (its host contains "-pooler"):
# serverless functions open and close connections constantly, and the pooler is
# what stops that exhausting the database's connection limit.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# NOT YET IN USE
# Added when milestone 2 (authentication) and milestone 4 (photograph upload)
# land. Listed here so the full set is visible in one place.
# ---------------------------------------------------------------------------
# CLERK_SECRET_KEY=""                    # server only, never reaches a browser
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""   # safe in the browser, by design
# BLOB_READ_WRITE_TOKEN=""               # permission to store photographs
